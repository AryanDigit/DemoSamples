<form method="POST" action="<%= service ? '/admin/services/' + service.id : '/admin/services' %>" enctype="multipart/form-data" class="panel">
  <div class="form-grid">
    <div class="form-group"><label>Title</label><input name="title" required value="<%= service?.title || '' %>"></div>
    <div class="form-group"><label>Slug</label><input name="slug" value="<%= service?.slug || '' %>" placeholder="auto-from-title"></div>
    <div class="form-group full"><label>Short description</label><input name="short_description" value="<%= service?.short_description || '' %>"></div>
    <div class="form-group full"><label>Full description</label><textarea name="description" style="min-height:140px"><%= service?.description || '' %></textarea></div>
    <div class="form-group"><label>Icon key</label><input name="icon" value="<%= service?.icon || 'star' %>" placeholder="palette, layout, code, camera..."></div>
    <div class="form-group"><label>Sort order</label><input name="sort_order" type="number" value="<%= service?.sort_order || 0 %>"></div>
    <div class="form-group"><label>Image URL</label><input name="image" value="<%= service?.image || '' %>"></div>
    <div class="form-group"><label>Or upload image</label><input type="file" name="image_file" accept="image/*"></div>
    <div class="form-group full"><label>Features (one per line)</label><textarea name="features"><%= service?.featuresText || '' %></textarea></div>
    <div class="form-group"><label>Meta title</label><input name="meta_title" value="<%= service?.meta_title || '' %>"></div>
    <div class="form-group"><label>Meta description</label><input name="meta_description" value="<%= service?.meta_description || '' %>"></div>
    <div class="form-group full check-row">
      <label><input type="checkbox" name="is_featured" value="1" <%= !service || service.is_featured ? 'checked' : '' %>> Featured</label>
      <label><input type="checkbox" name="is_published" value="1" <%= !service || service.is_published ? 'checked' : '' %>> Published</label>
    </div>
  </div>
  <button class="btn btn-teal" type="submit"><%= service ? 'Update' : 'Create' %> service</button>
  <a class="btn btn-outline" href="/admin/services">Cancel</a>
</form>
