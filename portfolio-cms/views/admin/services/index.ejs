<div class="panel">
  <div class="panel-head"><h2>All services</h2><a class="btn btn-teal btn-sm" href="/admin/services/new">Add service</a></div>
  <div class="table-wrap"><table>
    <thead><tr><th>Title</th><th>Featured</th><th>Status</th><th>Order</th><th></th></tr></thead>
    <tbody>
      <% services.forEach(function(s) { %>
      <tr>
        <td><strong><%= s.title %></strong><div class="help">/services/<%= s.slug %></div></td>
        <td><%= s.is_featured ? 'Yes' : '—' %></td>
        <td><span class="pill <%= s.is_published ? 'pill-green' : 'pill-gray' %>"><%= s.is_published ? 'Live' : 'Draft' %></span></td>
        <td><%= s.sort_order %></td>
        <td class="actions">
          <a class="btn btn-outline btn-sm" href="/admin/services/<%= s.id %>/edit">Edit</a>
          <form method="POST" action="/admin/services/<%= s.id %>/delete" style="display:inline" data-confirm="Delete this service?">
            <button class="btn btn-danger btn-sm" type="submit">Delete</button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table></div>
</div>
