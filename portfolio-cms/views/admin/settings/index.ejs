<div class="tabs">
  <a class="<%= tab==='general'?'active':'' %>" href="/admin/settings?tab=general">General</a>
  <a class="<%= tab==='hero'?'active':'' %>" href="/admin/settings?tab=hero">Hero</a>
  <a class="<%= tab==='about'?'active':'' %>" href="/admin/settings?tab=about">About</a>
  <a class="<%= tab==='contact'?'active':'' %>" href="/admin/settings?tab=contact">Contact & Social</a>
  <a class="<%= tab==='seo'?'active':'' %>" href="/admin/settings?tab=seo">SEO & Code</a>
  <a class="<%= tab==='account'?'active':'' %>" href="/admin/settings?tab=account">Account</a>
</div>

<% if (tab !== 'account') { %>
<form method="POST" action="/admin/settings" enctype="multipart/form-data" class="panel">
  <input type="hidden" name="_tab" value="<%= tab %>">

  <% if (tab === 'general') { %>
  <div class="form-grid">
    <div class="form-group"><label>Site name</label><input name="site_name" value="<%= settings.site_name || '' %>"></div>
    <div class="form-group"><label>Logo text</label><input name="logo_text" value="<%= settings.logo_text || '' %>"></div>
    <div class="form-group full"><label>Tagline</label><input name="site_tagline" value="<%= settings.site_tagline || '' %>"></div>
    <div class="form-group full"><label>Site description</label><textarea name="site_description"><%= settings.site_description || '' %></textarea></div>
    <div class="form-group"><label>Footer text</label><input name="footer_text" value="<%= settings.footer_text || '' %>"></div>
    <div class="form-group"><label>Copyright</label><input name="footer_copyright" value="<%= settings.footer_copyright || '' %>"></div>
    <div class="form-group full check-row">
      <label><input type="checkbox" name="show_preloader" value="1" <%= settings.show_preloader !== '0' ? 'checked' : '' %>> Show preloader</label>
      <label><input type="checkbox" name="maintenance_mode" value="1" <%= settings.maintenance_mode === '1' ? 'checked' : '' %>> Maintenance mode</label>
    </div>
  </div>
  <% } %>

  <% if (tab === 'hero') { %>
  <div class="form-grid">
    <div class="form-group"><label>Eyebrow</label><input name="hero_eyebrow" value="<%= settings.hero_eyebrow || '' %>"></div>
    <div class="form-group"><label>Hero image URL</label><input name="hero_image" value="<%= settings.hero_image || '' %>"></div>
    <div class="form-group full"><label>Hero title</label><input name="hero_title" value="<%= settings.hero_title || '' %>"></div>
    <div class="form-group full"><label>Hero subtitle</label><textarea name="hero_subtitle"><%= settings.hero_subtitle || '' %></textarea></div>
    <div class="form-group"><label>Primary CTA text</label><input name="hero_cta_text" value="<%= settings.hero_cta_text || '' %>"></div>
    <div class="form-group"><label>Primary CTA link</label><input name="hero_cta_link" value="<%= settings.hero_cta_link || '' %>"></div>
    <div class="form-group"><label>Secondary CTA text</label><input name="hero_cta2_text" value="<%= settings.hero_cta2_text || '' %>"></div>
    <div class="form-group"><label>Secondary CTA link</label><input name="hero_cta2_link" value="<%= settings.hero_cta2_link || '' %>"></div>
  </div>
  <% } %>

  <% if (tab === 'about') { %>
  <div class="form-grid">
    <div class="form-group"><label>About eyebrow</label><input name="about_subtitle" value="<%= settings.about_subtitle || '' %>"></div>
    <div class="form-group"><label>About image URL</label><input name="about_image" value="<%= settings.about_image || '' %>"></div>
    <div class="form-group full"><label>About title</label><input name="about_title" value="<%= settings.about_title || '' %>"></div>
    <div class="form-group full"><label>About content</label><textarea name="about_content" style="min-height:180px"><%= settings.about_content || '' %></textarea></div>
    <div class="form-group full"><label>Resume URL</label><input name="resume_url" value="<%= settings.resume_url || '' %>"></div>
  </div>
  <% } %>

  <% if (tab === 'contact') { %>
  <div class="form-grid">
    <div class="form-group"><label>Email</label><input name="contact_email" value="<%= settings.contact_email || '' %>"></div>
    <div class="form-group"><label>Phone</label><input name="contact_phone" value="<%= settings.contact_phone || '' %>"></div>
    <div class="form-group full"><label>Address</label><input name="contact_address" value="<%= settings.contact_address || '' %>"></div>
    <div class="form-group"><label>LinkedIn</label><input name="social_linkedin" value="<%= settings.social_linkedin || '' %>"></div>
    <div class="form-group"><label>Dribbble</label><input name="social_dribbble" value="<%= settings.social_dribbble || '' %>"></div>
    <div class="form-group"><label>Behance</label><input name="social_behance" value="<%= settings.social_behance || '' %>"></div>
    <div class="form-group"><label>GitHub</label><input name="social_github" value="<%= settings.social_github || '' %>"></div>
    <div class="form-group"><label>Instagram</label><input name="social_instagram" value="<%= settings.social_instagram || '' %>"></div>
    <div class="form-group"><label>Twitter / X</label><input name="social_twitter" value="<%= settings.social_twitter || '' %>"></div>
  </div>
  <% } %>

  <% if (tab === 'seo') { %>
  <div class="form-grid">
    <div class="form-group full"><label>Default SEO title</label><input name="seo_title" value="<%= settings.seo_title || '' %>"></div>
    <div class="form-group full"><label>Default SEO description</label><textarea name="seo_description"><%= settings.seo_description || '' %></textarea></div>
    <div class="form-group full"><label>Keywords</label><input name="seo_keywords" value="<%= settings.seo_keywords || '' %>"></div>
    <div class="form-group full"><label>Google Analytics / scripts</label><textarea name="google_analytics" style="min-height:120px" placeholder="Paste GA or GTM snippet"><%= settings.google_analytics || '' %></textarea></div>
    <div class="form-group full"><label>Custom CSS</label><textarea name="custom_css" style="min-height:120px"><%= settings.custom_css || '' %></textarea></div>
    <div class="form-group full"><label>Custom JS</label><textarea name="custom_js" style="min-height:100px"><%= settings.custom_js || '' %></textarea></div>
  </div>
  <% } %>

  <button class="btn btn-teal" type="submit">Save settings</button>
</form>
<% } else { %>
<div class="two-col">
  <form method="POST" action="/admin/settings/profile" class="panel">
    <h2 style="font-family:var(--display);font-size:1.1rem;margin:0 0 1rem">Profile</h2>
    <div class="form-group"><label>Name</label><input name="name" value="<%= currentUser?.name || '' %>" required></div>
    <div class="form-group"><label>Email</label><input name="email" type="email" value="<%= currentUser?.email || '' %>" required></div>
    <button class="btn btn-teal" type="submit">Update profile</button>
  </form>
  <form method="POST" action="/admin/settings/password" class="panel">
    <h2 style="font-family:var(--display);font-size:1.1rem;margin:0 0 1rem">Change password</h2>
    <div class="form-group"><label>Current password</label><input name="current_password" type="password" required></div>
    <div class="form-group"><label>New password</label><input name="new_password" type="password" minlength="8" required></div>
    <div class="form-group"><label>Confirm password</label><input name="confirm_password" type="password" minlength="8" required></div>
    <button class="btn btn-teal" type="submit">Update password</button>
  </form>
</div>
<% } %>
