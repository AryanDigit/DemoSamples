<section class="page-hero">
  <div class="container-wide">
    <div class="eyebrow">Insights</div>
    <h1><%= page?.title || 'Insights' %></h1>
    <p>Design thinking, product craft, and creative process.</p>
  </div>
</section>
<section style="padding-top:0">
  <div class="container-wide">
    <div class="blog-grid">
      <% posts.forEach(function(post, i) { %>
      <a class="blog-card" href="/blog/<%= post.slug %>" data-aos="fade-up" data-aos-delay="<%= (i % 3) * 70 %>">
        <div class="blog-card-media"><img src="<%= post.cover_image %>" alt="<%= post.title %>" loading="lazy"></div>
        <div class="meta"><%= post.category_name || 'Article' %> · <%= formatDate(post.published_at) %></div>
        <h3><%= post.title %></h3>
        <p><%= post.excerpt %></p>
      </a>
      <% }) %>
    </div>
  </div>
</section>
