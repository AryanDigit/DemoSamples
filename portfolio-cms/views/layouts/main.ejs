<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof meta !== 'undefined' && meta?.title ? meta.title : (settings.seo_title || siteName) %></title>
  <meta name="description" content="<%= typeof meta !== 'undefined' && meta?.description ? meta.description : (settings.seo_description || '') %>">
  <% if ((typeof meta !== 'undefined' && meta?.keywords) || settings.seo_keywords) { %>
  <meta name="keywords" content="<%= (typeof meta !== 'undefined' && meta?.keywords) ? meta.keywords : settings.seo_keywords %>">
  <% } %>
  <meta name="robots" content="index,follow">
  <link rel="canonical" href="<%= siteUrl %><%= (typeof meta !== 'undefined' && meta?.canonical) ? meta.canonical : '' %>">
  <meta property="og:type" content="<%= (typeof meta !== 'undefined' && meta?.type) ? meta.type : 'website' %>">
  <meta property="og:title" content="<%= typeof meta !== 'undefined' && meta?.title ? meta.title : (settings.seo_title || siteName) %>">
  <meta property="og:description" content="<%= typeof meta !== 'undefined' && meta?.description ? meta.description : (settings.seo_description || '') %>">
  <% if (typeof meta !== 'undefined' && meta?.image) { %><meta property="og:image" content="<%= meta.image %>"><% } %>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">
  <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <% if (settings.custom_css) { %><style><%- settings.custom_css %></style><% } %>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": settings.site_name || siteName,
    "url": siteUrl,
    "email": settings.contact_email || undefined,
    "description": settings.site_description || undefined
  }) %>
  </script>
</head>
<body>
  <% if (settings.show_preloader !== '0') { %>
  <div class="preloader" aria-hidden="true"><div class="preloader-brand"><%= settings.logo_text || siteName %></div></div>
  <% } %>
  <%- include('../partials/header') %>
  <main id="main">
    <%- body %>
  </main>
  <%- include('../partials/footer') %>
  <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  <script src="/js/main.js"></script>
  <% if (settings.custom_js) { %><script><%- settings.custom_js %></script><% } %>
  <% if (settings.google_analytics) { %><%- settings.google_analytics %><% } %>
</body>
</html>
